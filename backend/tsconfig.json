{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "noEmitOnError": true
  },
  
  "include": ["config/**/*.ts", "db/**/*.ts", "scanner/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}